#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std140) uniform First { uvec4 head; uint tail; } first;
layout(set=0,binding=1,std140) uniform Second { uint value; } second;
layout(set=0,binding=2,std140) uniform Third { uvec4 words[16]; } third;
layout(set=0,binding=3,std430) buffer Output { uint words[]; } outputData;
void main() {
    uint i=gl_GlobalInvocationID.x;
    uint j=i%70u;
    uint value;
    if(j<4u) value=first.head[j];
    else if(j==4u) value=first.tail;
    else if(j==5u) value=second.value;
    else value=third.words[(j-6u)/4u][(j-6u)%4u];
    outputData.words[i]=value*3u+(i^0x13579bdfu);
}
