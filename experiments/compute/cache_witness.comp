#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint factor = 3u;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint values[]; } src;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint values[]; } dst;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < 1024u) dst.values[i] = src.values[i] * factor + (i ^ 0x13579bdfu);
}
