#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 32) in;

struct Inner {
    vec2 pair[2];
    uint tail;
};

layout(std430, set = 0, binding = 0) uniform Input {
    uint scalar[8];
    vec2 pairs[4];
    layout(row_major) mat2x3 matrix;
    Inner nested[2];
} inputData;

layout(std430, set = 0, binding = 1) buffer Output {
    uint values[];
} outputData;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint index = i & 7u;
    outputData.values[i] = inputData.scalar[index]
        ^ floatBitsToUint(inputData.pairs[index & 3u].x)
        ^ floatBitsToUint(inputData.matrix[0][0])
        ^ floatBitsToUint(inputData.matrix[1][2])
        ^ floatBitsToUint(inputData.nested[index & 1u].pair[1].y)
        ^ inputData.nested[index & 1u].tail
        ^ (i * 0x9e3779b9u);
}
