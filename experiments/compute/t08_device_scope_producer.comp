#version 450 core
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require

#if defined(T08_DEVICE_SCOPE)
#define T08_SCOPE gl_ScopeDevice
#else
#define T08_SCOPE gl_ScopeQueueFamily
#endif

layout(local_size_x=32) in;
layout(set=0, binding=0) nonprivate buffer SharedData { uint value[]; } data;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    data.value[8u + index] = (index * 17u) ^ 0x59a31c4du;
    memoryBarrier(T08_SCOPE, gl_StorageSemanticsBuffer,
                  gl_SemanticsRelease | gl_SemanticsMakeAvailable);
}
