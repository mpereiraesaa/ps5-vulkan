#version 450 core
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require

#if defined(T08_DEVICE_SCOPE)
#define T08_SCOPE gl_ScopeDevice
#else
#define T08_SCOPE gl_ScopeQueueFamily
#endif

layout(local_size_x=32) in;
layout(set=0,binding=0) nonprivate buffer Payload { uint value[]; } payload;
layout(set=0,binding=1) nonprivate buffer Flags { uint value[]; } flags;
layout(set=0,binding=2) nonprivate buffer Result { uint value[]; } results;

void main()
{
    uint pair = (gl_WorkGroupID.x >> 1u) * 32u + gl_LocalInvocationID.x;
    uint slot = 8u + pair;
    uint expected = (pair * 17u) ^ 0x59a31c4du;
    if ((gl_WorkGroupID.x & 1u) == 0u) {
        payload.value[slot] = expected;
        memoryBarrier(T08_SCOPE, gl_StorageSemanticsBuffer,
                      gl_SemanticsRelease | gl_SemanticsMakeAvailable);
        atomicStore(flags.value[slot], 1u, T08_SCOPE,
                    gl_StorageSemanticsBuffer,
                    gl_SemanticsRelease | gl_SemanticsMakeAvailable);
    } else {
        uint seen = atomicLoad(flags.value[slot], T08_SCOPE,
                               gl_StorageSemanticsBuffer,
                               gl_SemanticsAcquire | gl_SemanticsMakeVisible);
        if (seen == 1u) {
            memoryBarrier(T08_SCOPE, gl_StorageSemanticsBuffer,
                          gl_SemanticsAcquire | gl_SemanticsMakeVisible);
            results.value[slot] = payload.value[slot] == expected ? 1u : 2u;
        } else {
            results.value[slot] = 0u;
        }
    }
}
