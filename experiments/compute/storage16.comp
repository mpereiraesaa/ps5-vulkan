#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer Input16 {
    uint16_t values[];
} input_data;

layout(set = 0, binding = 1, std430) writeonly buffer Output16 {
    uint16_t values[];
} output_data;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint value = uint(input_data.values[index]);
    output_data.values[index] = uint16_t((value * 5u + index + 11u) & 0xffffu);
}
