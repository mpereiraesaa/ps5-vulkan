#version 450
/* DXVK D3D11 resource forms in one dispatch of eight invocations:
 *   s0 + t0      separate SAMPLER and SAMPLED_IMAGE, combined at the use
 *                (sample_l, resinfo);
 *   u0           Buffer<uint> SRV, a UNIFORM_TEXEL_BUFFER (ld);
 *   o_u32/o_rgba8/o_rgba32f  RWBuffer<> UAVs, STORAGE_TEXEL_BUFFERs
 *                (store_uav_typed) of three formats.
 * The texture is sampled NEAREST at texel centres, so every result is exact. */
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler s0;
layout(set=0,binding=1) uniform texture2D t0;
layout(set=0,binding=2) uniform utextureBuffer u0;
layout(set=0,binding=3,r32ui) uniform writeonly uimageBuffer o_u32;
layout(set=0,binding=4,rgba8) uniform writeonly imageBuffer o_rgba8;
layout(set=0,binding=5,rgba32f) uniform writeonly imageBuffer o_rgba32f;
void main()
{
    uint i=gl_GlobalInvocationID.x;
    ivec2 size=textureSize(sampler2D(t0,s0),0);
    vec2 texel=vec2(float(i)+0.5,0.0)/vec2(size);
    vec4 row1=textureLod(sampler2D(t0,s0),texel+vec2(0.0,1.5/float(size.y)),0.0);
    vec4 row2=textureLod(sampler2D(t0,s0),texel+vec2(0.0,2.5/float(size.y)),0.0);
    uint fetched=texelFetch(u0,int(i)).x;
    imageStore(o_u32,int(i),uvec4(packUnorm4x8(row1)^fetched^uint(size.x),0u,0u,0u));
    imageStore(o_rgba8,int(i),row2);
    imageStore(o_rgba32f,int(i),vec4(float(fetched),float(size.x),float(size.y),float(i)));
}
