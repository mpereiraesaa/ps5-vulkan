#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint values[]; } src;
layout(set=0,binding=1,std430) writeonly buffer Output { uint values[]; } dst;
layout(set=1,binding=0,std140) uniform Params { uint bias; } params;
layout(set=2,binding=0) uniform usamplerBuffer lookup_values;
void main()
{
    uint i=gl_GlobalInvocationID.x;
    dst.values[i]=(src.values[i]+params.bias)^uint(texelFetch(lookup_values,int(i)).x);
}
