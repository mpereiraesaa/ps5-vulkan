#version 450
// T09 timeline witness: one GPU write whose completion a timeline value names.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) writeonly buffer Output { uint values[]; } data;
layout(push_constant) uniform Parameters { uint seed; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    data.values[i] = (i * 2654435761u) ^ params.seed;
}
