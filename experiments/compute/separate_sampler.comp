#version 450
/* DXVK's DXBC resource forms in one compute shader: a separate sampler and
 * sampled image combined with OpSampledImage at the use (sample_l, resinfo),
 * a uniform texel buffer read with OpImageFetch (ld) and a storage texel
 * buffer written with OpImageWrite (store_uav_typed). Bindings follow DXVK's
 * in-set order: SAMPLER sorts first, then SAMPLED_IMAGE, then the buffers. */
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler s0;
layout(set=0,binding=1) uniform texture2D t0;
layout(set=0,binding=2) uniform utextureBuffer typed_input;
layout(set=0,binding=3,r32ui) uniform writeonly uimageBuffer typed_output;
void main()
{
    uint i=gl_GlobalInvocationID.x;
    vec4 texel=textureLod(sampler2D(t0,s0),vec2((float(i)+0.5)/8.0,0.5),0.0);
    uint fetched=texelFetch(typed_input,int(i)).x;
    uint width=uint(textureSize(sampler2D(t0,s0),0).x);
    imageStore(typed_output,int(i),uvec4(packUnorm4x8(texel)^fetched^width,0u,0u,0u));
}
