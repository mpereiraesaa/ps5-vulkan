#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer Results {
    uint values[];
} results;

void main()
{
    results.values[gl_GlobalInvocationID.x] =
        0x62000000u | (gl_WorkGroupID.x << 16) | gl_LocalInvocationID.x;
}
