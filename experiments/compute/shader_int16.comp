#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) readonly buffer Input { uint value; } input_data;
layout(set = 0, binding = 1) writeonly buffer Output { uint value; } output_data;

void main()
{
    uint16_t narrow = uint16_t(input_data.value);
    output_data.value = uint(narrow + uint16_t(7));
}
