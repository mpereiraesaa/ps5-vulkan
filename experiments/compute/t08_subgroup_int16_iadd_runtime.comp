#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_subgroup_extended_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Data { uint words[]; } data;

void main()
{
    uint source = data.words[gl_WorkGroupID.x * 2u + gl_SubgroupID];
    int16_t value = int16_t(source * 97u + gl_SubgroupInvocationID * 13u);
    data.words[16u + gl_GlobalInvocationID.x] = uint(subgroupAdd(value));
}
