#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer Input8 {
    uint8_t values[];
} input_data;

layout(set = 0, binding = 1, std430) writeonly buffer Output8 {
    uint8_t values[];
} output_data;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint value = uint(input_data.values[index]);
    output_data.values[index] = uint8_t((value * 3u + index + 7u) & 0xffu);
}
