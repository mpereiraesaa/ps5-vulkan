      }
    },
    {
      "id": "hashed-artifacts-declare-hashes",
      "description": "Any artifact used for verification must carry both a sha256 and a git blob id.",
      "check": {
        "op": "every_hashable_artifact_has",
        "fields": [
          "sha256",
          "git_blob_sha1"
