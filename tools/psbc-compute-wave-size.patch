+         * even for wide subgroup intrinsics. */
+        const unsigned wave_size = opts->compute_wave_size == 64 ? 64 : 32;
+        compiler_info.key.cs_wave_size = wave_size;
+        compiler_info.subgroup_size = wave_size;
+        compiler_info.min_subgroup_size = wave_size;
+        compiler_info.max_subgroup_size = wave_size;
     }
     compiler_info.key.family = chipfamily;
     compiler_info.key.ps5_buffer_scratch = opts->compute_buffer_spills;
